  "items": {
    "data-1": {
      "label": "データの役割分担",
      "status": "採用方針",
      "summary": "運用タスクはSheet、表示・詳細はJSON、共通設定は専用の設定ファイルで管理する。",
      "specification": "Googleスプレッドシート「実装進捗管理シート」を運用上のタスク管理元とする。依頼タスク／完了／対応中タスクのナレッジ／コメントの各タブを使う。対応中ナレッジは完了時に削除し、完了側との重複を避ける。tasks.jsonは画面表示に必要な構造・詳細・経緯を保持し、AI設定・ポリシーはそれぞれの専用ファイルで管理する。",
      "constraints": [
        "SheetとJSONは同期処理で揃える。画面操作直後に全媒体が同時更新される設計ではない。"
      ],
      "sources": [
        {
          "label": "README.md",
          "url": "https://github.com/gurii-gabreh/progress-tracker-dashboard/blob/5aa2c2415b21e6f12901c8bba9828649e8daa218/README.md"
        },
        {
          "label": "data/ai-config.json",
          "url": "https://github.com/gurii-gabreh/progress-tracker-dashboard/blob/5aa2c2415b21e6f12901c8bba9828649e8daa218/data/ai-config.json"
        },
        {
          "label": "gas/Code.gs",
          "url": "https://github.com/gurii-gabreh/progress-tracker-dashboard/blob/5aa2c2415b21e6f12901c8bba9828649e8daa218/gas/Code.gs"
        }
      ]
    },
    "data-2": {
      "label": "タスク・相談事項の構造",
      "status": "実装あり",
      "summary": "タスクは一意IDと再帰的な子タスクを持ち、相談事項は同じリポジトリ内のテーマとして整理する。",
      "specification": "タスクにid、title、依頼内容task、subtasks、detail、checkHistory、issues、nextAction等を持たせる。detailは最新の要約、checkHistoryは時系列の確認経緯、issuesは課題を分離して記録する。手動作業はmanualSetup等の項目で表す。相談事項はリポジトリ内のテーマとしてまとめ、実装タスクの階層とは区別して扱う。",
      "constraints": [],
      "sources": [
        {
          "label": "data/tasks.json",
          "url": "https://github.com/gurii-gabreh/progress-tracker-dashboard/blob/5aa2c2415b21e6f12901c8bba9828649e8daa218/data/tasks.json"
        },
        {
          "label": "dashboard.html",
          "url": "https://github.com/gurii-gabreh/progress-tracker-dashboard/blob/5aa2c2415b21e6f12901c8bba9828649e8daa218/dashboard.html"
        },
        {
          "label": "README.md",
          "url": "https://github.com/gurii-gabreh/progress-tracker-dashboard/blob/5aa2c2415b21e6f12901c8bba9828649e8daa218/README.md"
        }
      ]
    },
    "data-3": {
      "label": "親タスクの状態集計",
      "status": "実装あり",
      "summary": "孫以下まで再帰的に集計し、未完了の子孫を完了扱いで隠さない。",
      "specification": "aggregateStatusで下位階層まで状態を確認する。全て完了なら親を完了とし、未完了がある場合は判断待ち等の優先順位に基づいて親の状態を表示する。直接の子が完了でも、孫以下に未完了がある場合は未完了として扱う。",
      "constraints": [],
      "sources": [
        {
          "label": "dashboard.html",
          "url": "https://github.com/gurii-gabreh/progress-tracker-dashboard/blob/5aa2c2415b21e6f12901c8bba9828649e8daa218/dashboard.html"
        }
      ]
    },
    "data-4": {
      "label": "関連タスクの共通データ",
      "status": "実装あり",
      "summary": "depends_on／blocks／relates_toをtasks.jsonに持ち、関係図へ利用する。",
      "specification": "relatedTasksの各要素に対象id、type、noteを記録する。typeは依存、妨げる関係、関連を区別する。関係図専用の重複したデータファイルを作らず、既存のタスクデータから関係を生成する。",
      "constraints": [
        "古いタスク全件への関連付けの遡及入力は完了仕様に含めない。記載された関係だけを表示する。"
      ],
      "sources": [
