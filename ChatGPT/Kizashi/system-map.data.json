        }
      ]
    },
    "rooms": {
      "label": "ルームとD1",
      "status": "実装あり",
      "summary": "6桁コードを共有範囲にし、事案と関連データを保存する。",
      "specification": "incidents、family_intake、floor_plans、precursor_signsをD1へ保存する。各ルートでresolveRoomを使い、ルームコードと期限を確認する。",
      "constraints": [
        "個人ごとのログイン・管理者ロールではない。コードを知る人を単位に共有する方式。"
