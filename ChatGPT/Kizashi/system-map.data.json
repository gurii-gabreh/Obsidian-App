      ]
    },
    "purge": {
      "label": "期限切れの削除",
      "status": "実装あり",
      "summary": "終了から30日後を期限とし、日次処理で関連データを消す。",
      "specification": "ルーム終了操作でexpires_atを設定し、scheduledから期限切れの問診・間取り・前兆・事案をdb.batchで削除する。",
      "constraints": [
        "終了していない事案に30日の期限が自動設定されるわけではない。"
      ],
