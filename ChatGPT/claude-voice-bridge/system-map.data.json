      ]
    },
    "dom": {
      "label": "content scriptの橋渡し",
      "status": "実装あり",
      "summary": "AIサイトの入力欄と応答DOMを操作する。",
      "specification": "chrome.tabs.sendMessageで文字列を渡し、content.jsが入力・送信・応答監視・抽出を担当する。セレクタ上書きもできる。",
      "constraints": [
        "AI APIを直接呼ぶ方式ではなく、Web UIの構造変更に影響される。"
